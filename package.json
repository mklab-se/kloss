{
  "name": "@mklab-se/kloss",
  "version": "0.2.1",
  "description": "Build models from virtual bricks, by hand or through MCP",
  "keywords": [
    "bricks",
    "building",
    "3d",
    "model",
    "mcp",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "author": "Kristofer Liljeblad <kristofer@mklab.se>",
  "homepage": "https://github.com/mklab-se/kloss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mklab-se/kloss.git"
  },
  "bugs": "https://github.com/mklab-se/kloss/issues",
  "type": "module",
  "bin": {
    "kloss": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun build src/cli.ts --compile --minify --sourcemap --outfile dist/kloss",
    "sbom": "bun scripts/sbom.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
